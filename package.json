{
  "name": "dsh-deepseek-whale-lite",
  "version": "0.3.0",
  "description": "官方 DSH 桌面端 DeepSeek 双来源余额与调用统计挂件",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "PROVENANCE.md",
    "LICENSE",
    "docs"
